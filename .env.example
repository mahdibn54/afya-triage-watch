# Copy to .env and change every value marked CHANGE_ME. Never commit .env.
# passwords must be URL-safe: generate with openssl rand -hex 24
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=CHANGE_ME
AFYA_OWNER_PASSWORD=CHANGE_ME
AFYA_APP_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME_long_random_string

# Model (E5-11). Default: the open-weights model Qwen3-30B-A3B-Instruct-2507 through OpenRouter, provider pinned.
# The prototype holds synthetic patients only; a real deployment runs the same open-weights model hosted in-country.
MODEL_PROVIDER=openrouter
OPENROUTER_MODEL=qwen/qwen3-30b-a3b-instruct-2507
OPENROUTER_PROVIDER=nebius/fp8
# Your key (set a spending limit on it at openrouter.ai). Empty = rules only, with the "no model" notice.
OPENROUTER_API_KEY=
# The remote provider is used only while this says synthetic; any other value refuses it (rules only).
DATA_CLASSIFICATION=synthetic
# Optional local model instead: MODEL_PROVIDER=ollama (Ollama listening on 172.17.0.1, never 0.0.0.0)
OLLAMA_BASE_URL=http://host.docker.internal:11434
MODEL=qwen3:8b
MODEL_SEED=42
# 0 = never call the model (rules only; proposals still appear with a "no model" notice)
MODEL_ENABLED=1

# Demo sign-in switcher (known gap: no real authentication)
DEMO_MODE=1
# Nurse UI: 1 = fake JSON from docs/api.md until the E6 endpoints exist (E7-10)
FAKE_API=0
WATCH_INTERVAL_SECONDS=60
