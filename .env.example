# Copy to .env and change every value marked CHANGE_ME. Never commit .env.
# passwords must be URL-safe: generate with openssl rand -hex 24
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=CHANGE_ME
AFYA_OWNER_PASSWORD=CHANGE_ME
AFYA_APP_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME_long_random_string
# E13-3: OAuth 2.1 client secret of the api (client "afya-api") at the local authorization server (Authelia, service
# "auth"). The api trades it for short-lived, per-mount access tokens to afya-mcp; it never leaves the api, auth-init
# and the host-side eval harness. Generate: openssl rand -hex 32
AFYA_MCP_CLIENT_SECRET=CHANGE_ME

# Model (E5-11). Always an open-weights model. Pick the provider with MODEL_PROVIDER: ollama_cloud (the default),
# groq, openrouter or ollama (local); each provider's model is set by its own variable below. The prototype holds
# synthetic patients only; a real deployment runs the same open-weights model hosted in-country.
MODEL_PROVIDER=ollama_cloud
# A model name exactly as GET https://ollama.com/api/tags lists it (gpt-oss:120b: Apache-2.0 open weights, tools)
OLLAMA_CLOUD_MODEL=gpt-oss:120b
# Your key from https://ollama.com/settings/keys (sent only to ollama.com). Empty = rules only, "no model" notice.
OLLAMA_API_KEY=
# MODEL_PROVIDER=groq: GroqCloud's free plan (no card). gpt-oss-120b free limits: 30 requests/min, 1K requests/day,
# 8K tokens/min, 200K tokens/day; the api paces itself and falls back to the rules when a limit is hit.
GROQ_MODEL=openai/gpt-oss-120b
# Qwen comparison: set MODEL_PROVIDER=groq and GROQ_MODEL=qwen/qwen3.8-27b in your local .env.
# Keep DATA_CLASSIFICATION=synthetic and MODEL_ENABLED=1; add your own GROQ_API_KEY below.
# Your key from https://console.groq.com/keys (sent only to api.groq.com). Empty = rules only, "no model" notice.
GROQ_API_KEY=
# Alternative: MODEL_PROVIDER=openrouter (open-weights Qwen3-30B-A3B-Instruct-2507, provider pinned)
OPENROUTER_MODEL=qwen/qwen3-30b-a3b-instruct-2507
OPENROUTER_PROVIDER=nebius/fp8
# Your key (set a spending limit on it at openrouter.ai). Empty = rules only, with the "no model" notice.
OPENROUTER_API_KEY=
# The remote provider is used only while this says synthetic; any other value refuses it (rules only).
DATA_CLASSIFICATION=synthetic
# Optional local model instead: MODEL_PROVIDER=ollama (Ollama listening on 172.17.0.1, never 0.0.0.0)
OLLAMA_BASE_URL=http://host.docker.internal:11434
MODEL=qwen3:8b
MODEL_SEED=42
# 0 = never call the model (rules only; proposals still appear with a "no model" notice)
MODEL_ENABLED=1

# Demo sign-in switcher (known gap: no real authentication)
DEMO_MODE=1
WATCH_INTERVAL_SECONDS=60
