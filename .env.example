# Copy to .env and change every value marked CHANGE_ME. Never commit .env.
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=CHANGE_ME
AFYA_OWNER_PASSWORD=CHANGE_ME
AFYA_APP_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME_long_random_string

# Model (Ollama on the host GPU by default)
OLLAMA_BASE_URL=http://host.docker.internal:11434
MODEL=qwen3:8b

# OpenRouter comparison: off by default, synthetic fixtures only
ALLOW_REMOTE_MODEL=false
OPENROUTER_API_KEY=

# Demo sign-in switcher (known gap: no real authentication)
DEMO_MODE=1
WATCH_INTERVAL_SECONDS=60
